# ----------------------------------------------------------------------------
# FinSight — Environment variables
# ----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma ORM (app runtime + Prisma CLI).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finsight?schema=public"

# Optional: dedicated shadow database for `prisma migrate dev`.
# Only needed if your Postgres user cannot create databases.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finsight_shadow?schema=public"

# ----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5) — Phase 2B
# ----------------------------------------------------------------------------

# Secret used to sign/encrypt session tokens (JWTs). REQUIRED in production.
# Generate a strong value with:  openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="generate-and-paste-a-64-char-random-secret-here"

# Canonical app URL (Auth.js trusted-host detection). Adjust per environment.
AUTH_TRUST_HOST="http://localhost:3000"
